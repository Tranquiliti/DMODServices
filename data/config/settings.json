#-- Note for LunaLib users --#
# LunaLib overrides the settings here.
# Use LunaLib's in-game UI configs to toggle these instead.
{
	"dmodservices": {
		# Enables access to D-MOD service centers in size 6+ markets.
		"enableDMODServices": true,

		# Multiplies the base cost for adding a selected d-mod to a ship
		# This does not change how the cost scales with additional d-mods.
		# Default value is the base credit value of a pristine ship
		"selectDModCostMult": 1.0,

		# Adding a selected d-mod also applies the 'unrestorable' tag
		# to the ship, preventing any d-mod removal from either
		# dockyard restoration or the Hull Restoration skill.
		# Default value is 'false'
		"selectDModAddUnrestorable": false,

		# Enables all 'dmod'-tagged hullmods to appear as options, with no specific restrictions,
		# when adding selected d-mods for a ship.
		# Default value is 'false'
		"selectDModEnableAllDMods": false,

		# Multiplies the base cost for removing a selected s-mod from a ship.
		# Default value is the base credit value of a pristine ship
		"removeSModCostMult": 1.0,

		# Removing at least the base maximum number of s-mods also
		# removes the 'unrestorable' tag from the selected ship
		# The base maximum number of s-mods is specified in "maxPermanentHullmods" of Starsector's settings.json.
		# Default value is 'false'
		"removeSModRemoveUnrestorable": false,

		# Adds the option of fully-automating a selected ship while visiting a D-MOD service center,
		# but only if you have discovered and defeated a certain defender fleet.
		# Default value is 'false'
		"enableAutomateOption": false,

		# Multiplies the base cost for automating a ship.
		# Default value is 3x times the base credit value of a pristine ship
		"automateCostMult": 3.0,

		# Automating a ship also adds the 'unrestorable' tag to the ship.
		# The dialogue remains unaffected if this option is disabled.
		# Default value is 'true'
		"automateAddUnrestorable": true,

		# Automating a ship also applies the 'no_auto_penalty' tag to the ship,
		# preventing the ship from counting against the Automated Ships skill or similar.
		# Default value is 'true'
		"automateAddNoAutoPenalty": true,
	},


	# Other
	"ruleCommandPackages":["org.tranquility.dmodservices.rulecmd"]
}